# Smart Voting System - backend environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- Outbound email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Must be the authenticated mailbox: Gmail rejects a From address that is not
# the signed-in account (or a verified alias).
SMTP_SENDER_EMAIL=you@example.com
SMTP_SENDER_NAME=Smart Voting System
# Gmail: use a 16-character App Password (Google Account > Security > App
# passwords), NOT your normal account password. Requires 2-Step Verification.
SMTP_APP_PASSWORD=
# Socket timeout for SMTP connections, seconds.
SMTP_TIMEOUT=20

# OTP lifetime in seconds (default 600 = 10 minutes).
OTP_TTL_SECONDS=600

# Optional: public base URL of the frontend (used in email links, if any).
APP_BASE_URL=
